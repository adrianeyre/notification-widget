// Optional. Copy this file to Config/Secrets.xcconfig (git-ignored) and fill it in.
//
// The Google and Slack clients are entered in the app: Settings → Accounts → Setup.
// This file only signs the app with your Apple team, which lets it read macOS Focus
// status (so Alerts go quiet during a Focus). Without it the app runs fine and Alerts
// simply ignore Focus.

// Xcode → Settings → Accounts → your team's 10-character ID.
DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_ENTITLEMENTS = App/NotificationWidget/NotificationWidget.entitlements
